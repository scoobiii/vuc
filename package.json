{
  "name": "@vortexfoundation/vua",
  "version": "1.0.0",
  "description": "Vortex Universal Adapter & Governed Execution Protocol for AI Agents, MCP and LLMs",
  "type": "module",
  "main": "./src/vortex/index.ts",
  "types": "./src/vortex/index.ts",
  "bin": {
    "vua": "./bin/vua.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/scoobiii/vua.git"
  },
  "keywords": [
    "vortex",
    "vua",
    "mcp",
    "ai-agents",
    "governance",
    "ed25519",
    "rfc8785",
    "llm",
    "security",
    "claude",
    "cursor"
  ],
  "author": "Vortex Open Protocol Foundation",
  "license": "MIT",
  "files": [
    "bin",
    "src/vortex",
    "dist",
    "README.md"
  ],
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "install:bend": "bash scripts/install-bend.sh",
    "bend": "./bin/native/bin/bend",
    "test:drex": "tsx tests/drex-bend-parity.test.ts",
    "test:drex-integrity": "tsx tests/drex-execution-integrity.test.ts",
    "test:parity": "tsx tests/drex-bend-parity.test.ts",
    "bench:drex-network": "tsx scripts/measure-drex-network.ts",
    "test:drex-network": "tsx scripts/measure-drex-network.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "npm run lint && npm run test:unit && npm run test:integration && npm run test:security && npm run test:drex-integrity && npm run test:drex-p0 && npm run test:mock && npm run test:stress && npm run test:chaos && npm run test:bench && tsx scripts/run-full-suite.ts",
    "test:ci": "npm run test",
    "test:unit": "tsx tests/unit.test.ts",
    "test:integration": "tsx tests/integration.test.ts",
    "test:mock": "tsx tests/mock-detector.test.ts",
    "test:stress": "tsx tests/stress.test.ts",
    "test:chaos": "tsx tests/chaos.test.ts",
    "test:caos": "tsx tests/chaos.test.ts",
    "test:bench": "tsx tests/performance-bench.test.ts",
    "test:policy": "tsx tests/patch-arena-policy.test.ts",
    "test:diff": "tsx tests/vua-governance-differential.test.ts",
    "test:arena": "tsx scripts/agent-patch-arena.ts",
    "test:threads": "tsx scripts/test-threads.ts",
    "verify:gos3": "tsx scripts/verify-gos3-headers.ts --strict",
    "vua": "tsx bin/vua.js",
    "bench": "tsx bin/vua.js bench",
    "bench:gcloud": "tsx bin/vua.js bench --cloud",
    "bench:mcp": "tsx scripts/run-mcp-benchmark.ts",
    "bench:semantic": "tsx scripts/run-semantic-benchmark.ts",
    "tao:compare": "tsx scripts/tao-compare.ts",
    "vua:prove": "tsx scripts/vua-prove-equivalent.ts",
    "vua:llms": "tsx scripts/vua-llm-resolve.ts",
    "mcp": "tsx bin/mcp-server.js",
    "test:security": "tsx tests/oauth-security.test.ts && tsx tests/security-full-audit.test.ts",
    "test:k6": "tsx tests/k6/k6-runner.ts",
    "test:k6:industry": "tsx tests/k6/k6-runner.ts industry",
    "test:k6:smoke": "tsx tests/k6/k6-runner.ts smoke",
    "test:k6:load": "tsx tests/k6/k6-runner.ts load",
    "test:k6:stress": "tsx tests/k6/k6-runner.ts stress",
    "test:k6:spike": "tsx tests/k6/k6-runner.ts spike",
    "test:k6:soak": "tsx tests/k6/k6-runner.ts soak",
    "test:k6:chaos": "tsx tests/k6/k6-runner.ts chaos",
    "test:k6:degradation": "tsx tests/k6/k6-runner.ts degradation",
    "build:cli": "esbuild bin/vua.js --bundle --platform=node --format=cjs --packages=external --outfile=dist/vua.cjs && chmod +x dist/vua.cjs",
    "test:drex-p0:valid-transfer": "tsx tests/drex-p0/valid-transfer.test.ts",
    "test:drex-p0:no-mutation-on-proof-failure": "tsx tests/drex-p0/no-mutation-on-proof-failure.test.ts",
    "test:drex-p0:no-bend-no-fallback": "tsx tests/drex-p0/no-bend-no-fallback.test.ts",
    "test:drex-p0:bend-process-failure": "tsx tests/drex-p0/bend-process-failure.test.ts",
    "test:drex-p0:unexpected-output": "tsx tests/drex-p0/unexpected-output.test.ts",
    "test:drex-p0:hash-binding": "tsx tests/drex-p0/hash-binding.test.ts",
    "test:drex-p0:canonical-tamper": "tsx tests/drex-p0/canonical-tamper.test.ts",
    "test:drex-p0:signature-tamper": "tsx tests/drex-p0/signature-tamper.test.ts",
    "test:drex-p0": "npm run test:drex-p0:valid-transfer && npm run test:drex-p0:no-mutation-on-proof-failure && npm run test:drex-p0:no-bend-no-fallback && npm run test:drex-p0:bend-process-failure && npm run test:drex-p0:unexpected-output && npm run test:drex-p0:hash-binding && npm run test:drex-p0:canonical-tamper && npm run test:drex-p0:signature-tamper"
  },
  "dependencies": {
    "@google-cloud/firestore": "^9.1.0",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.19.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "swagger-ui-express": "^5.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/swagger-ui-express": "^4.1.8",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
